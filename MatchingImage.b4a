@EndOfDesignText@
#Region  Activity Attributes 
	#FullScreen: true
	#IncludeTitle: false
	#ApplicationLabel: Flash Cards
	#SignKeyPassword: malakingtite
	#VersionCode: 3
	#VersionName: 1.0
#End Region
Sub Process_Globals
	'These global variables will be declared once when the application starts.
	'These variables can be accessed from all modules.
Dim cl1 As MediaPlayer
Dim cl2 As MediaPlayer

Dim bg1 As MediaPlayer
Dim bg2 As MediaPlayer
Dim succ As MediaPlayer
Dim tick As MediaPlayer
Dim flip1 As MediaPlayer
Dim flip2 As MediaPlayer
Dim flip3 As MediaPlayer
Dim alarm As MediaPlayer
Dim vl1, vl2 As Float = 0.5
Dim mods As String=""
	Dim datlist As List
	Dim usr As String ="Player1"
Dim tim As String = ""
Dim sc As Int = 0 
Dim tutor As Boolean = False
Dim ldl As String = "Please Wait..."
Dim img As ContentChooser
End Sub
Sub Globals
	'These global variables will be redeclared each time the activity is created.
	'These variables can only be accessed from this module.

	Private b1 As Button
	Private b2 As Button
	Private b3 As Button
	Private b4 As Button
	Private inp As Panel
	Private conf As Button
	Private usern As Label
	Private prob As Button
	Private username As EditText
	Dim pic As Panel
	Dim pics As ImageView
	Private Label1 As Label
End Sub
#Region mains

Sub Activity_Create(FirstTime As Boolean)
	'Do not forget to load the layout file created with the visual designer. For example:
	Activity.LoadLayout("menu")
	datlist.Initialize
	conf.Color = Colors.ARGB(0, 0, 0, 0)
	prob.Color = Colors.ARGB(0, 0, 0, 0)
	
	img.initialize("img")
	pics.Bitmap = LoadBitmap(File.DirAssets,"cards (66).png")
		If File.Exists(File.DirInternal, "volume.txt") Then
		Dim savedData As String = File.ReadString(File.DirInternal, "volume.txt")
		Dim parts() As String = Regex.Split(",", savedData)
		Dim vol1 As Float = parts(0)
		Dim vol2 As Float = parts(1)
		vl1 = vol1
		vl2 = vol2
	End If
	If FirstTime Then
		If bg1.IsInitialized = False Then
			bg1.Initialize()
			bg1.Load(File.DirAssets, "nbgm4.mp3")
			bg1.SetVolume(vl1, vl1)
			bg1.Looping = True
		End If
		bg2.Initialize()
		bg2.Load(File.DirAssets, "nbgm3.mp3")
		bg1.SetVolume(vl1, vl1)
		bg2.SetVolume(vl1, vl1)
		bg2.Looping = True
	
		cl1.Initialize
		cl1.Load(File.DirAssets, "pop1.mp3")
		cl1.SetVolume(vl2,vl2)
		cl2.Initialize
		cl2.Load(File.DirAssets, "pop3.mp3")
		cl2.SetVolume(vl2,vl2)

		succ.Initialize
		tick.Initialize
		flip1.Initialize
		flip2.Initialize
		flip3.Initialize
		alarm.Initialize
		succ.Load(File.DirAssets,"success.mp3")
		tick.Load(File.DirAssets,"tick.mp3")
		flip1.Load(File.DirAssets,"flip.mp3")
		flip2.Load(File.DirAssets,"flip2.mp3")
		flip3.Load(File.DirAssets,"flip2.mp3")
		alarm.Load(File.DirAssets,"alarm.mp3")
		bg1.Looping = True
		bg2.Looping = True
		succ.SetVolume(vl2, vl2)
		tick.SetVolume(vl2, vl2)
		flip1.SetVolume(vl2, vl2)
		flip2.SetVolume(vl2, vl2)
		flip3.SetVolume(vl2, vl2)
		alarm.SetVolume(vl2, vl2)
'		If bg1.IsPlaying = False Then
'			bg1.play
'		End If
	End If
	
	cl1.Initialize
	cl2.Initialize
	bg1.Initialize
	bg2.Initialize
	succ.Initialize
	tick.Initialize
	flip1.Initialize
	flip2.Initialize
	flip3.Initialize
	alarm.Initialize
	cl1.Load(File.DirAssets, "pop1.mp3")
	cl2.Load(File.DirAssets,"pop3.mp3")
	bg1.Load(File.DirAssets,"nbgm4.mp3")
	bg2.Load(File.DirAssets,"nbgm3.mp3")
	succ.Load(File.DirAssets,"success.mp3")
	tick.Load(File.DirAssets,"tick.mp3")
	flip1.Load(File.DirAssets,"flip.mp3")
	flip2.Load(File.DirAssets,"flip2.mp3")
	flip3.Load(File.DirAssets,"flip2.mp3")
	alarm.Load(File.DirAssets,"alarm.mp3")
	bg1.Looping = True
	bg2.Looping = True

	If File.Exists(File.DirInternal, "volume.txt") Then
		Dim savedData As String = File.ReadString(File.DirInternal, "volume.txt")
		Dim parts() As String = Regex.Split(",", savedData)
		Dim vol1 As Float = parts(0)
		Dim vol2 As Float = parts(1)
		vl1 = vol1
		vl2 = vol2
	End If

	If File.Exists(File.DirInternal, "history.txt") Then
		datlist = File.ReadList(File.DirInternal, "history.txt")

	End If

	


	If File.Exists(File.DirInternal, "tutorial.txt") Then
		Dim s As String = File.ReadString(File.DirInternal, "tutorial.txt")
		Dim isFinished As Boolean = (s.ToLowerCase = "true")
		tutor = isFinished
	else if s = "true" Then
		tutor = True
	Else If tutor = False Then
	'	ShowTutorialHighlight
		tutor = True
	End If
	File.WriteString(File.DirInternal, "tutorial.txt", "true")
	If File.Exists(File.DirInternal, "username.txt") Then
	Dim users As String = File.ReadString(File.DirInternal, "username.txt")
	usern.Text = users
	username.Text = users
	usr = users
End If
	usern.Text = usr

Label1.Text = "v1.0.2 Build-3"
End Sub

Sub Activity_Resume
	If bg1.IsInitialized = False Then
		bg1.Initialize()
		bg1.Load(File.DirAssets, "nbgm4.mp3")
		bg1.SetVolume(vl1, vl1)
		bg1.Looping = True
	End If

	bg2.Initialize()
	bg2.Load(File.DirAssets, "nbgm3.mp3")
	bg1.SetVolume(vl1, vl1)
	bg2.SetVolume(vl1, vl1)
	bg2.Looping = True
	
	
	cl1.Initialize
	cl1.Load(File.DirAssets, "pop1.mp3")
	cl1.SetVolume(vl2,vl2)
	cl2.Initialize
	cl2.Load(File.DirAssets, "pop3.mp3")
	cl2.SetVolume(vl2,vl2)



	succ.Initialize
	tick.Initialize
	flip1.Initialize
	flip2.Initialize
	flip3.Initialize
	alarm.Initialize
	succ.Load(File.DirAssets,"success.mp3")
	tick.Load(File.DirAssets,"tick.mp3")
	flip1.Load(File.DirAssets,"flip.mp3")
	flip2.Load(File.DirAssets,"flip2.mp3")
	flip3.Load(File.DirAssets,"flip2.mp3")
	alarm.Load(File.DirAssets,"alarm.mp3")
	succ.SetVolume(vl2, vl2)
	tick.SetVolume(vl2, vl2)
	flip1.SetVolume(vl2, vl2)
	flip2.SetVolume(vl2, vl2)
	flip3.SetVolume(vl2,vl2)
	alarm.SetVolume(vl2, vl2)
	If bg1.IsPlaying = False Then
	bg1.play
	End If
End Sub

Sub Activity_Pause (UserClosed As Boolean)
	bg1.Pause
End Sub


Private Sub b4_Click
	cl1.play
	StartActivity(history)
End Sub

Private Sub b3_Click
	cl1.play
	StartActivity(credits)
End Sub

Private Sub b2_Click
	cl1.play
	StartActivity(settings)
End Sub

Private Sub b1_Click
	cl1.play
	StartActivity(difficulty)
	Activity.Invalidate
	Sleep(0)
End Sub

Private Sub conf_Click
	cl1.play
	inp.Visible = False
	b1.Enabled=True
	b2.Enabled=True
	b3.Enabled=True
	b4.Enabled=True
	prob.Enabled=True
	usern.text = username.Text
	
	If username.Text = "" Then
		username.Text = "Player1"
	End If
	
	File.WriteString(File.DirInternal, "username.txt", username.text)
End Sub

Private Sub prob_Click
	cl2.play
	inp.Visible = True
	inp.BringToFront
	inp.BringToFront
	username.RequestFocus
	b1.Enabled=False
	b2.Enabled=False
	b3.Enabled=False
	b4.Enabled=False
	prob.Enabled=False
	username.Text = usern.text
End Sub



Private Sub pics_Click
img.show("image/*","Choose Image")
End Sub

Sub img_Result(succs As Boolean, dirs As String, fn As String)
	If succs Then
		pics.Bitmap = LoadBitmap(dirs, fn)
		Else
			ToastMessageShow("Please Select an Image", True)
	End If
End Sub

#End Region